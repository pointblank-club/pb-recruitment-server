STAGE=<dev/production>
FIREBASE_SERVICE_ACCOUNT_PATH=<firebase-json-file-path>
DB_ADDR=<neondb-connection-string>
AWS_ACCESS_KEY_ID=<aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>
AWS_REGION=<aws-region>
S3_SUBMISSIONS_BUCKET=<s3-submissions-bucket-name>
# Optional S3-compatible endpoint (e.g. Neon storage); enables path-style requests.
AWS_ENDPOINT_URL_S3=
#Optional
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m
ENABLE_SWAGGER=false

# Judge0 (for the EC2 SSH tunnel, see README; use a reachable address in deployment)
JUDGE0_URL=http://127.0.0.1:2358
JUDGE0_AUTH_TOKEN=
# Leave both callback settings empty for local recovery polling.
JUDGE0_CALLBACK_BASE_URL=
# Required whenever callbacks are enabled; use a long random secret.
JUDGE0_CALLBACK_SECRET=
# Dispatch timeout in milliseconds; default and maximum are 10000
JUDGE0_TIMEOUT_MS=10000
# Must not exceed the Judge0 instance's batch limit; default is 20
JUDGE0_BATCH_SIZE=20

# Rate Limiting & Leaderboard Cache (optional, keep identical across replicas)
# Cooldown between submissions in seconds; default is 5
SUBMISSION_RATE_LIMIT_SECONDS=5
# Leaderboard in-memory cache TTL in seconds; default is 3, max recommended is 60
LEADERBOARD_CACHE_TTL_SECONDS=3
